# Crawler — environment variables
# Never commit real keys. Server secrets live in Project Settings → Secrets.

# ---------------------------------------------------------------------------
# Paddle (payments)
# ---------------------------------------------------------------------------
# Client-side token. Test token (test_…) in .env.development,
# live token (live_…) in .env.production.
VITE_PAYMENTS_CLIENT_TOKEN="live_xxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Server-side API keys (secrets, never in the bundle)
PADDLE_SANDBOX_API_KEY="pdl_sdbx_apikey_..."
PADDLE_LIVE_API_KEY="pdl_live_apikey_..."

# Notification-destination signing secrets, per environment
PAYMENTS_SANDBOX_WEBHOOK_SECRET="pdl_ntfset_..."
PAYMENTS_LIVE_WEBHOOK_SECRET="pdl_ntfset_..."

# Force the billing environment ("sandbox" or "live").
# Omit to derive it from the available API keys.
PADDLE_ENV="live"

# Optional explicit price overrides; otherwise prices are resolved by their
# external ids crawler_plus_monthly / crawler_pro_monthly / crawler_business_monthly.
# PADDLE_PRICE_PLUS="pri_..."
# PADDLE_PRICE_PRO="pri_..."
# PADDLE_PRICE_BUSINESS="pri_..."

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL="https://crawler.today"
